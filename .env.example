# ═══════════════════════════════════════════════════════════════
# e-commerce-project — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────
DATABASE_URL="prisma+postgres://your-connection-string-here"

# ── Payments ─────────────────────────────────────────────────
# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""

# Stripe (alternative)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── Email ────────────────────────────────────────────────────
# For order confirmation emails
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# ── Storage ──────────────────────────────────────────────────
# For product images (Cloudinary, S3, etc.)
CLOUDINARY_URL=""

# ── Analytics ────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=""

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
