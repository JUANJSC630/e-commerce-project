# ═══════════════════════════════════════════════════════════════
# e-commerce-project - Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────
# Desarrollo: Postgres local. Se conecta sin TLS (ver src/lib/db-connection.ts).
#   brew services start postgresql@16
#   createdb dulceinfancia_dev
#   npx prisma migrate deploy && npx tsx prisma/seed.ts   (con Node >= 20)
DATABASE_URL="postgres://TU_USUARIO@127.0.0.1:5432/dulceinfancia_dev"
#
# Producción: base gestionada (Prisma Postgres). Exige sslmode y verificación
# completa del certificado; va en las variables del hosting, nunca aquí.

# ── Payments ─────────────────────────────────────────────────
# Active payment provider: "mock" (simulated, default) or "mercadopago".
# With "mock", checkout routes to an internal simulated payment page.
PAYMENT_PROVIDER="mock"

# MercadoPago (used when PAYMENT_PROVIDER=mercadopago)
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""

# Stripe (alternative)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── Email ────────────────────────────────────────────────────
# For order confirmation emails
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# ── Cron ─────────────────────────────────────────────────────
# Shared token for Vercel Cron (abandoned-order reminders).
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# ── Storage ──────────────────────────────────────────────────
# Product image uploads via UploadThing. Get the token from your app's
# dashboard: https://uploadthing.com/dashboard → API Keys.
UPLOADTHING_TOKEN=""

# ── Analytics ────────────────────────────────────────────────
# GA4 measurement id (G-XXXXXXX) y Meta Pixel id. Vacío = no se inyecta nada.
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
