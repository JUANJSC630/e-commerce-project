# Copy this file to .env.local and fill in the values
# Never commit .env.local to version control

# ─── Pagos: proveedor activo ──────────────────────────────────────────────────
# 'mock' (simulador, sin credenciales) | 'mercadopago'
# Futuro: 'wompi' | 'stripe' (Bloques 10.5 / 10.6 del ROADMAP)
# Para replicar la tienda con otro cliente: cambia el proveedor aquí y llena
# SOLO las claves de ese proveedor - el código no cambia.
PAYMENT_PROVIDER=mock

# ─── MercadoPago ──────────────────────────────────────────────────────────────
# Credenciales: https://www.mercadopago.com.co/developers/panel/app
# Desarrollo: usar credenciales TEST- (el server rechaza APP_USR- fuera de prod)
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Clave secreta del webhook (panel → Webhooks → Configurar notificaciones).
# Sin ella el endpoint /api/payments/webhook/mercadopago rechaza todo (fail closed).
MERCADOPAGO_WEBHOOK_SECRET=
# Solo para probar PSE en sandbox: las apps creadas por una cuenta VENDEDOR de
# prueba emiten tokens APP_USR- (su universo entero es sandbox). Nunca usar
# con credenciales de tu cuenta real.
# MERCADOPAGO_ALLOW_PROD_TOKEN_IN_DEV=true

# ─── Wompi (Colombia - Bloque 10.5, aún no implementado) ─────────────────────
# https://comercios.wompi.co - claves pub_test_/prv_test_ (sandbox) o _prod_
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=

# ─── Stripe (internacional - Bloque 10.6, aún no implementado) ───────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Sanity CMS (product catalog) ────────────────────────────────────────────
# https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# ─── Analytics ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# ─── Email transaccional (Bloque 11) ─────────────────────────────────────────
# Producción: Resend. https://resend.com/api-keys - clave con Full access.
# El dominio de EMAIL_FROM debe estar verificado en resend.com/domains.
RESEND_API_KEY=
EMAIL_FROM=noreply@dulceinfancia.co

# Desarrollo: captura local con Mailpit (incluido en Herd). Bandeja: http://localhost:8025
# Con SMTP_HOST puesto NADA sale a internet, aunque exista RESEND_API_KEY.
# Probar los 5 emails:  yarn verify:emails tu@correo.com
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# ─── Cron (recordatorio de pedidos abandonados) ──────────────────────────────
# Token compartido: el llamador envía "Authorization: Bearer <CRON_SECRET>".
# Sirve igual para Vercel Cron (vercel.json) que para cron-job.org.
# Genera uno con: openssl rand -hex 32
# Probar el cron end-to-end:  yarn verify:cron
CRON_SECRET=

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
