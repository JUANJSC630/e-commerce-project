generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  permissions Json     @default("{}")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  name      String?
  image     String?
  roleId    String
  role      Role       @relation(fields: [roleId], references: [id])
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  orders    Order[]
  favorites Favorite[]
  reviews   Review[]
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Category {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  description     String?
  image           String?
  imageAlt        String?
  metaTitle       String?
  metaDescription String?
  order           Int        @default(0)
  isActive        Boolean    @default(true)
  // Self-relation for subcategories. A null parent = top-level category.
  parentId        String?
  parent          Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[] @relation("CategoryTree")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  products        Product[]

  @@index([parentId])
}

model Product {
  id            String      @id @default(cuid())
  name          String
  price         Float
  originalPrice Float?
  image         String      @default("/placeholder.svg")
  imageAlt      String?
  category      String
  categoryId    String?
  categoryRef   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sizes         String[]    @default([])
  colors        String[]    @default([])
  description   String?
  isOnSale      Boolean     @default(false)
  isNew         Boolean     @default(false)
  isFeatured    Boolean     @default(false)
  isPublished   Boolean     @default(true)
  stock         Int         @default(0)
  rating        Float?
  reviewCount   Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[]
  // Gallery shown on the product detail page. `image` above stays the cover
  // (card thumbnail); these are the additional ordered photos.
  images        ProductImage[]
  // Purchasable size×color combinations. When a product has variants, stock,
  // price and image are resolved per variant; `stock`/`sizes`/`colors`/`price`
  // above act as fallbacks for products without variants (backwards compat).
  variants      ProductVariant[]
  // Customer reviews. `rating`/`reviewCount` above are denormalized aggregates
  // recomputed from the approved reviews on every change.
  reviews       Review[]

  @@index([categoryId])
}

/// A customer review of a product (1–5 stars + optional comment). One per user
/// per product. The product's `rating`/`reviewCount` are recomputed from these.
model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName String
  rating     Int
  comment    String?
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([productId, userId])
  @@index([productId])
}

/// A purchasable size×color combination of a product, each with its own stock,
/// optional price override (null → inherits the product price), SKU and image.
/// Deleted in cascade with the product; order items keep a snapshot so deleting
/// a variant only nulls the back-reference (onDelete: SetNull on OrderItem).
model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       String?
  color      String?
  sku        String?     @unique
  price      Float?
  stock      Int         @default(0)
  imageUrl   String?
  position   Int         @default(0)
  createdAt  DateTime    @default(now())
  orderItems OrderItem[]

  @@index([productId])
}

/// Additional gallery photos for a product, ordered by `position`. The product's
/// `image` column remains the cover/thumbnail; the storefront detail page renders
/// the cover first, then these. Deleted in cascade with the product.
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerEmail   String?
  customerName    String?
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  // Gateway settlement trail: which provider charged, its payment id, the
  // idempotency key sent with the charge (unique → a retry can never double-bill)
  // and how many attempts the customer has made against this order.
  paymentProvider   String?
  paymentProviderId String?
  idempotencyKey    String?     @unique
  pseRedirectUrl    String?
  paymentAttempts   Int         @default(0)
  // Set when the "complete your payment" reminder for an abandoned order is sent,
  // so the cron never emails the same customer twice.
  reminderSentAt    DateTime?
  total           Float
  subtotal        Float
  shippingCost    Float         @default(0)
  // Fulfillment tracking, set by the admin when the order ships.
  carrier         String?
  trackingNumber  String?
  // Applied discount snapshot: the code used and the amount it took off, so the
  // order total stays auditable even if the Discount is later edited or deleted.
  discountCode    String?
  discountAmount  Float         @default(0)
  // Tax (IVA) recorded on the order for invoicing. When prices include tax this
  // is the portion already inside the total; otherwise it was added to it.
  taxAmount       Float         @default(0)
  items           OrderItem[]
  shippingAddress Json?
  paymentMethod   String?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  paymentLogs     PaymentLog[]

  @@index([createdAt])
  @@index([status])
}

/// Append-only audit trail of every payment event (gateway responses and
/// webhook deliveries), kept verbatim for reconciliation and disputes.
model PaymentLog {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider   String
  event      String
  providerId String?
  status     String
  rawPayload Json
  createdAt  DateTime @default(now())

  @@index([orderId])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  // The specific variant purchased, when the product has variants. Nulled if the
  // variant is later deleted — size/color/price below snapshot what was bought.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity  Int
  price     Float
  size      String?
  color     String?
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

enum DiscountType {
  PERCENTAGE // `value` is a percent off the subtotal (0–100)
  FIXED // `value` is a fixed amount off the subtotal (order currency)
  FREE_SHIPPING // zeroes the shipping cost; `value` ignored
}

/// A checkout discount code. Validated server-side on every order: active, within
/// its date window, under its redemption cap and meeting the minimum subtotal.
model Discount {
  id             String       @id @default(cuid())
  code           String       @unique
  type           DiscountType @default(PERCENTAGE)
  value          Float        @default(0)
  /// Minimum order subtotal required to apply (null = no minimum).
  minSubtotal    Float?
  /// Total times the code may be redeemed (null = unlimited).
  maxRedemptions Int?
  redemptions    Int          @default(0)
  isActive       Boolean      @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model RateLimitHit {
  id         String   @id @default(cuid())
  action     String
  identifier String
  createdAt  DateTime @default(now())

  @@index([action, identifier, createdAt])
}
